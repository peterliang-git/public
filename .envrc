$AWS_ACCESS_KEY_ID = "test"
$AWS_SECRET_ACCESS_KEY = "test"
$AWS_DEFAULT_REGION = "us-east-1"
$SQS_QUEUE = "event-sqs-queue"
$SQS_EVENT_SRC_ARN = "aws_sqs_queue.event-sqs-queue.arn"

$TF_VAR_access_key  = $AWS_ACCESS_KEY_ID
$TF_VAR_secret_key  = $AWS_SECRET_ACCESS_KEY
$TF_VAR_region      = $AWS_DEFAULT_REGION
$TF_VAR_sqs_queue   = $SQS_QUEUE
$TF_VAR_sqs_event_source_arn   = $SQS_EVENT_SRC_ARN